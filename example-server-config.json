{
  "bind": "0.0.0.0",
  "control_port": 9000,
  "http_port": 8080,
  "https_port": 8443,
  "cert": "/etc/letsencrypt/live/tunnel.example.com/fullchain.pem",
  "key": "/etc/letsencrypt/live/tunnel.example.com/privkey.pem",
  "domain": "tunnel.example.com",
  "public_host": "tunnel.example.com",
  "token": "your-secret-token-here-use-gen-token",
  "admin_token": "admin-secret-token-for-admin-api",
  "tcp_port_range": "20000-20100",
  "allow_any_port": false,
  "access_log": "/var/log/tunnel/access.log",
  "max_connections_per_ip": 10,
  "max_requests_per_second": 100,
  "session_timeout": 1800,
  "allow_ips": ["10.0.0.0/8", "192.168.0.0/16", "203.0.113.0/24"],
  "structured_logs": false
}
