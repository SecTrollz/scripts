# Example LAN Relay Server Configuration (KEY=VALUE format)
# Optimized for local LAN + WireGuard VPN access
# Usage: python3 ngrok_tunnel.py server --config example-lan-relay-config.env

# NETWORK CONFIGURATION
# Bind to your relay device's LAN IP (find with: hostname -I)
# Example: 192.168.1.50 (adjust to your setup)
bind=192.168.1.50
control_port=9000
http_port=8080

# SECURITY - REQUIRED!
# Generate token with: python3 ngrok_tunnel.py gen-token
# Share securely with tunnel clients only
token=your-secret-token-here

# Restrict access to LAN only (since relay is internal)
# Allow internal networks
allow_ips=192.168.1.0/24
# Optionally deny specific hosts on LAN
# deny_ips=192.168.1.100/32

# SESSION & TIMEOUT
# How long before idle tunnels disconnect (in seconds)
# 3600 = 1 hour (suitable for stable LAN)
# 300 = 5 minutes (safer for untrusted networks)
session_timeout=3600

# RATE LIMITING
# Adjust based on number of concurrent tunnels
# LAN: Can be more generous than public internet
max_connections_per_ip=20
max_requests_per_second=200

# LOGGING
# Enable access logging for debugging
access_log=/var/log/tunnel/relay.log
# Use structured JSON logs (easier to parse)
structured_logs=false

# NO HTTPS NEEDED FOR LAN!
# HTTPS is optional - LAN traffic is generally trusted
# Uncomment only if you want encryption:
# https_port=8443
# cert=/etc/letsencrypt/live/relay.local/fullchain.pem
# key=/etc/letsencrypt/live/relay.local/privkey.pem

# NO DOMAIN NEEDED FOR LAN!
# Subdomain routing only works with wildcard DNS
# For LAN, clients access tunnels by IP:
# curl http://192.168.1.50:8080/devicea-app

# OPTIONAL: Identity-based auth (zero-trust)
# For high security, enable cryptographic identity:
# identity_seed_hash=abc123def456...
