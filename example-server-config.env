# Example server configuration (KEY=VALUE format)
# Load with: python3 ngrok_tunnel.py server --config example-server-config.env
# CLI arguments override config file values

# Network bindings
bind=0.0.0.0
control_port=9000
http_port=8080

# HTTPS/TLS (optional)
# https_port=8443
# cert=/etc/letsencrypt/live/tunnel.example.com/fullchain.pem
# key=/etc/letsencrypt/live/tunnel.example.com/privkey.pem

# Domain configuration (for wildcard subdomain routing)
# domain=tunnel.example.com
# public_host=tunnel.example.com

# Authentication (strongly recommended)
token=your-secret-token-here-use-gen-token
# admin_token=admin-secret-token-for-admin-api

# TCP tunnel configuration
tcp_port_range=20000-20100
allow_any_port=false

# Logging and monitoring
access_log=/var/log/tunnel/access.log
max_connections_per_ip=10
max_requests_per_second=100

# Session and security
session_timeout=1800

# IP filtering (comma-separated CIDR ranges)
# allow_ips=10.0.0.0/8,192.168.0.0/16,203.0.113.0/24
# deny_ips=192.168.1.0/24

# Logging format
# structured_logs=false
